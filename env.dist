# Log level for runtime actions: debug, info, warn or error
LOG_LEVEL=info

# The public key Commerce signs webhooks with (Stores > Settings > Configuration > Adobe Services >
# Webhooks > Digital Signature Configuration). Paste the full PEM block on one line with \n escapes,
# or as-is if your shell keeps line breaks. Required: unsigned webhook calls are rejected.
COMMERCE_WEBHOOKS_PUBLIC_KEY=
